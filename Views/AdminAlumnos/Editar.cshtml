@model Eva_Sxxi_Prepa_2025.Models.Alumno
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool editar = ViewContext.RouteData.Values["action"].ToString() == "Editar";
}

<h2 class="text-center mb-4">@((editar ? "Editar" : "Nuevo")) Alumno</h2>

<form method="post">
    @if (editar)
    {
        <input type="hidden" name="Matricula" value="@Model.Matricula" />
    }

    <div class="mb-3">
        <label class="form-label">Matrícula</label>
        <input type="text" class="form-control" name="Matricula" value="@Model.Matricula" @(editar ? "readonly" : "") required />
    </div>

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input type="text" class="form-control" name="Nombre" value="@Model.Nombre" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Apellido Paterno</label>
        <input type="text" class="form-control" name="Apellido1" value="@Model.Apellido1" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Apellido Materno</label>
        <input type="text" class="form-control" name="Apellido2" value="@Model.Apellido2" />
    </div>

    <div class="mb-3">
        <label class="form-label">Semestre</label>
        <input type="text" class="form-control" name="Semestre" value="@Model.Semestre" />
    </div>

    <div class="mb-3">
        <label class="form-label">Grupo</label>
        <input type="text" class="form-control" name="Grupo" value="@Model.Grupo" />
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save"></i> Guardar
    </button>
    <a href="/AdminAlumnos/Index" class="btn btn-secondary">Cancelar</a>
</form>
