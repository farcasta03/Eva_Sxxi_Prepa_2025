@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var alumno = ViewBag.Alumno;
    var departamentos = ViewBag.Departamentos;
}

<h2 class="mb-4 text-center">Evaluación de Departamentos</h2>
<p class="text-center">
    <strong>@alumno.Nombre</strong> — Matrícula: @alumno.Matricula<br />
    Semestre: @alumno.Semestre | Grupo: @alumno.Grupo
</p>

<div class="list-group mt-4">
    @foreach (var dep in departamentos)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-building me-2 text-primary"></i>
                <strong>@dep.Nombre</strong>
            </div>
            <a class="btn btn-secondary btn-sm"
               href="/Evaluacion/FormularioDepartamento?departamentoId=@dep.DepartamentoId">
                <i class="fas fa-clipboard-check"></i> Evaluar
            </a>
        </div>
    }
</div>

<div class="text-center mt-4">
    <a class="btn btn-outline-primary" href="/Evaluacion/Menu">
        <i class="fas fa-arrow-left"></i> Regresar al Menú
    </a>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        @if (TempData["Mensaje"] != null)
        {
            <text>toastr.success("@TempData["Mensaje"]");</text>
        }

        @if (TempData["Alerta"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'info',
                            title: 'Información',
                            text: '@TempData["Alerta"]',
                            confirmButtonColor: '#800020'
                        });
            </text>
        }
        });
    </script>
}
