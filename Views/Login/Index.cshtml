@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Login - Preparatoria Siglo XXI</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            height: 100vh;
            background: linear-gradient(-45deg, #003366, #800020, #1a1a2e, #16213e);
            background-size: 400% 400%;
            animation: backgroundAnimation 15s ease infinite;
            font-family: 'Poppins', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            color: #00ffff;
        }

        @@keyframes backgroundAnimation {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .login-container {
            position: relative;
            width: 800px;
            height: 480px;
            display: flex;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.3);
        }

            .login-container::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(0deg, transparent, #00ffff, #00ffff, transparent);
                animation: animateBorder 6s linear infinite;
                z-index: 1;
                filter: blur(2px);
            }

        @@keyframes animateBorder {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .login-container::after {
            content: '';
            position: absolute;
            inset: 4px;
            background: rgba(0, 0, 0, 0.8);
            z-index: 2;
            border-radius: 14px;
        }

        .login-box, .login-info {
            position: relative;
            z-index: 3;
            width: 50%;
            padding: 40px;
        }

        .login-box {
            background: transparent;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .login-box h1,
            .login-box h6,
            .login-info h2,
            .login-info p,
            label {
                color: #00ffff;
                text-shadow: 0 0 8px #00ffff;
            }

        .form-control {
            background-color: rgba(0, 0, 0, 0.6);
            color: #00ffff;
            border: 1px solid #00ffff;
            border-radius: 8px;
            box-shadow: 0 0 5px #00ffff;
            margin-bottom: 1.5rem;
        }

        ::placeholder {
            color: #00ffff;
        }

        .btn-login {
            background: #00ffff;
            color: #000;
            font-weight: bold;
            border-radius: 10px;
            box-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff;
            transition: 0.3s;
        }

            .btn-login:hover {
                background: #00cccc;
                box-shadow: 0 0 20px #00ffff, 0 0 30px #00ffff;
            }

        .login-info {
            background: linear-gradient(to bottom right, #003366, #800020);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #00ffff;
        }

            .login-info h2 {
                font-weight: 700;
                font-size: 24px;
            }

            .login-info p {
                margin-top: 10px;
                text-align: center;
                max-width: 200px;
                font-size: 14px;
            }

        .text-danger {
            font-size: 14px;
            margin-bottom: 10px;
            color: #ff5c5c;
            text-shadow: 0 0 5px #ff5c5c;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-box">
            <h1>Preparatoria<br />Siglo XXI</h1>
            <h6>Evaluación Docente</h6>

            @if (ViewBag.Mensaje != null)
            {
            <div class="text-danger">@ViewBag.Mensaje</div>
            }

            <form method="post">
                <input type="text" name="matricula" class="form-control" placeholder="Matrícula" required />
                <input type="password" name="apellido1" class="form-control" placeholder="Primer Apellido" required />
                <button type="submit" class="btn btn-login w-100">Iniciar Sesión</button>
            </form>
        </div>
        <div class="login-info">
            <h2>¡Bienvenido!</h2>
            <p>Ingresa tus datos para comenzar la evaluación de forma rápida y segura.</p>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
