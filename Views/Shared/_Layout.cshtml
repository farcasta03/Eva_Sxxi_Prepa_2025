<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Preparatoria Siglo XXI</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Toastr -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <style>
        /* Fondo con degradado animado estilo aurora */
        body {
            background: linear-gradient(-45deg, #001f3f, #800020, #003366, #4b0018);
            background-size: 500% 500%;
            animation: fondoAnimado 20s ease infinite;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            color: #f1f1f1;
        }

        @@keyframes fondoAnimado {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        /* Caja central tipo glassmorphism */
        .container {
            background: rgba(255, 255, 255, 0.08);
            padding: 2.5rem;
            border-radius: 20px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            margin-top: 2rem;
            animation: fadeIn 1.2s ease;
        }

        /* Entrada suave */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Títulos con neón sutil */
        h1, h2, h3, h4, label {
            color: #ffffff;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.35);
        }

        /* Campos */
        input, select, textarea {
            background: rgba(255, 255, 255, 0.12);
            border: 2px solid #ffffff33;
            border-radius: 12px;
            padding: 0.75rem;
            color: #ffffff;
            transition: all 0.3s ease;
            width: 100%;
        }

            input::placeholder,
            textarea::placeholder {
                color: #cccccc;
            }

            input:focus, select:focus, textarea:focus {
                background-color: rgba(255, 255, 255, 0.2);
                outline: none;
                box-shadow: 0 0 12px #ffffffaa;
            }

            /* Checkbox */
            input[type="checkbox"] {
                width: 20px;
                height: 20px;
                accent-color: #ffffff;
                border: 2px solid #ffffff;
            }

        /* Botones con efecto pulse */
        button, .btn {
            background-color: transparent;
            border: 2px solid #ffffff;
            color: #ffffff;
            padding: 0.6rem 1.4rem;
            border-radius: 10px;
            font-weight: bold;
            box-shadow: 0 0 12px rgba(255,255,255,0.3);
            transition: all 0.4s ease;
            text-shadow: 0 0 5px #ffffff88;
            position: relative;
            overflow: hidden;
        }

            button:hover, .btn:hover {
                background-color: #ffffff;
                color: #003366;
                box-shadow: 0 0 18px #ffffff;
            }

            /* Botón con pulso animado */
            button::after, .btn::after {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(255,255,255,0.3) 10%, transparent 40%);
                animation: pulse 2s infinite;
                z-index: 0;
            }

            button span, .btn span {
                position: relative;
                z-index: 1;
            }

        @@keyframes pulse {
            0% {
                transform: scale(0.9);
                opacity: 0.7;
            }

            50% {
                transform: scale(1.1);
                opacity: 0.4;
            }

            100% {
                transform: scale(0.9);
                opacity: 0.7;
            }
        }

        /* Botón de peligro */
        .btn-outline-danger {
            border: 2px solid #ff4d4d;
            color: #ff4d4d;
            background-color: transparent;
        }

            .btn-outline-danger:hover {
                background-color: #ff4d4d;
                color: #ffffff;
            }

        /* Enlaces */
        a {
            color: #66d9ff;
            text-decoration: none;
        }

            a:hover {
                color: #ffffff;
                text-shadow: 0 0 12px #66d9ff;
            }
    </style>

    <link rel="stylesheet" href="~/css/site.css" />

</head>
<body>
    <div class="container">
        @RenderBody()
    </div>

    <!-- JS Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @RenderSection("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  
</body>
</html>
