@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var resultados = ViewBag.Resultados;
}

<h2 class="text-center mb-4">Reporte de Evaluación de Docentes</h2>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Docente</th>
            <th>Materia</th>
            <th>Promedio</th>
            <th>Evaluaciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in resultados)
        {
            <tr>
                <td>@item.Docente</td>
                <td>@item.Materia</td>
                <td>@item.Promedio</td>
                <td>@item.Evaluaciones</td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center mt-4">
    <a href="/Admin" class="btn btn-outline-primary">
        <i class="fas fa-arrow-left"></i> Regresar al Menú
    </a>
</div>
